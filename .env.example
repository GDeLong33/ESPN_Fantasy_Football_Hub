# Local development only. Never commit a real .env file.
# In CI these come from GitHub Actions secrets / variables.

# ESPN (server-side fetch script only, never shipped to the browser)
LEAGUE_ID=
SEASON=2026
ESPN_S2=
ESPN_SWID=

# Supabase (Phase 4)
# The anon key is public by design and is safe in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The service role key is for GitHub Actions scripts only. Never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
